# =============================================================================
# AntiSlop Master Environment Configuration (env/.env.example)
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to:  env/.env   (gitignored — NEVER commit env/.env!)
#   2. Paste your Tier 3 Gemini API key(s) below.
#   3. Both /backend and /studio read from env/.env (or synced local env files).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED — Gemini 4 API Keys (from ai.dev / project gemini4nyc26nyc-2215)
# -----------------------------------------------------------------------------
# Primary Tier 3 Gemini API Key (e.g., Default Gemini API Key ...1LuQ)
GEMINI_API_KEY=

# Optional Secondary Tier 3 Key (e.g., Workshop API Key ...b2_8)
# Enables round-robin parallel pooling for Best-of-N candidate racing & 5-Sigma benchmarks
GEMINI_API_KEY_SECONDARY=

# -----------------------------------------------------------------------------
# 2. MODEL ROUTING (Gemini 4 Family + Decisions API + Media Models)
# -----------------------------------------------------------------------------
GEMINI_MODEL_DIRECTOR=gemini-4-carbon
GEMINI_MODEL_ARCHITECT=gemini-4-neon
GEMINI_MODEL_PATCHER=gemini-4-hydrogen
GEMINI_MODEL_FAST_CRITIC=gemini-4-argon
GEMINI_MODEL_DECISIONS=gemini-decision-1
GEMINI_MODEL_IMAGE_GEN=gemini-nano-banana-2.1
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
GEMINI_MODEL_TRANSCRIBE=gemini-3.5-transcribe
GEMINI_MODEL_LIVE=gemini-3.8-live
GEMINI_MANAGED_AGENT_BASE=antigravity-preview-09-2026

# Parallel Best-of-N candidate count (leverages Tier 3 throughput; set 1-4)
ANTISLOP_PARALLEL_CANDIDATES=3
ANTISLOP_MAX_CRITIC_ITERATIONS=4

# -----------------------------------------------------------------------------
# 3. RUNTIME PORTS & URLS (Local Dev vs Production)
# -----------------------------------------------------------------------------
BACKEND_PORT=4000
TARGET_VITE_PORT=5173
STUDIO_PORT=3000

# Public URL of the deployed Backend (Cloud Run URL in prod, localhost in dev)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Public URL of the live target preview (proxied through backend /preview or direct Vite)
NEXT_PUBLIC_PREVIEW_URL=http://localhost:4000/preview/
# Allowed CORS origin for Studio frontend (e.g. https://antislop.live)
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 4. GOOGLE CLOUD HOSTING (Personal GCP: patilshantanu1899@gmail.com)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_ARTIFACT_BUCKET=
CLOUD_RUN_SERVICE=antislop-engine

# -----------------------------------------------------------------------------
# 5. OPTIONAL — Observability & GitHub Integration
# -----------------------------------------------------------------------------
# LangSmith tracing (optional — wraps native @google/genai calls with traceable())
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=antislop-gemini4-nyc

# GitHub Personal Access Token (optional — for Managed Agent remote repo PR/push)
GITHUB_TOKEN=
