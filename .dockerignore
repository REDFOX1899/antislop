# Exclude local deps, secrets, frontend build, git history, and runtime artifacts from Docker/Cloud Build
.git
.gitignore
.DS_Store
.en
env/
.env
.env.*
**/node_modules
**/dist
studio/
benchmarks/
docs/
backend/uploads/
backend/screenshots/
backend/.snapshots/
backend/.workspaces/
target-repo/public/generated/*
target-templates/*/public/generated/*
*.log
