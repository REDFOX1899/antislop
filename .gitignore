# Dependencies
node_modules/
target-repo/node_modules/
target-templates/*/node_modules/
studio/node_modules/
backend/node_modules/
benchmarks/node_modules/

# Secrets & Environment Files (NEVER commit real keys!)
.env
.env.*
!.env.example
env/.env
env/.env.*
!env/.env.example
*.local
*.pem
*.key
*service-account*.json
*credentials*.json
env/*.json
.gcloud/

# Build Outputs
dist/
build/
coverage/
target-repo/dist/
target-templates/*/dist/
studio/.next/
studio/out/
backend/dist/

# Runtime Artifacts & Generated Media
*.log
.DS_Store
.gemini/
tmp/
backend/uploads/
backend/screenshots/
backend/.snapshots/
backend/.workspaces/
target-repo/public/generated/*
!target-repo/public/generated/.gitkeep
target-templates/*/public/generated/*
!target-templates/*/public/generated/.gitkeep
benchmarks/results/raw/
*.tsbuildinfo
.en
